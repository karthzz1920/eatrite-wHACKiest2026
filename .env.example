# Everything below is OPTIONAL. The app runs fully without any of it.
PORT=3000
# AWS Bedrock (AI explanations + reading diet-chart photos). Uses standard AWS credentials.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# ElevenLabs text-to-speech (read-aloud for elders). Falls back to browser speech if unset.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
